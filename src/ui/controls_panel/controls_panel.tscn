[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/controls_panel/controls_panel.gd" id="1_controls"]
[ext_resource type="LabelSettings" path="res://src/ui/theme/heading.tres" id="2_heading"]

[node name="ControlsPanel" type="VBoxContainer"]
custom_minimum_size = Vector2(480, 0)
theme_override_constants/separation = 10
script = ExtResource("1_controls")

[node name="Title" type="Label" parent="."]
layout_mode = 2
text = "Controles"
label_settings = ExtResource("2_heading")
horizontal_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Grid" type="GridContainer" parent="Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 6
columns = 3

[node name="BackButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "Volver"
