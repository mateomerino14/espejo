[gd_scene format=3]

[ext_resource type="Script" path="res://src/player/components/photo_camera.gd" id="1_camera"]
[ext_resource type="AudioStream" path="res://assets/audio/shutter.wav" id="2_shutter"]
[ext_resource type="AudioStream" path="res://assets/audio/focus.wav" id="3_focus"]

[node name="PhotoCamera" type="Node3D"]
script = ExtResource("1_camera")

[node name="FlashLight" type="SpotLight3D" parent="."]
light_color = Color(0.93, 0.96, 1, 1)
light_energy = 0.0
shadow_enabled = true
shadow_bias = 0.08
shadow_normal_bias = 2.0
spot_range = 14.0
spot_angle = 55.0

[node name="Shutter" type="AudioStreamPlayer3D" parent="."]
stream = ExtResource("2_shutter")
bus = &"Efectos"

[node name="Focus" type="AudioStreamPlayer3D" parent="."]
stream = ExtResource("3_focus")
volume_db = -8.0
bus = &"Efectos"
